<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_synthetic" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" value="0.20, 0.45, 0.70" />
    <input name="metalness" type="float" value="0.0" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1.0, 1.0, 1.0" />
    <input name="specular_roughness" type="float" value="0.30" />
    <input name="specular_IOR" type="float" value="1.52" />
  </standard_surface>
  <surfacematerial name="Synthetic_StandardSurface" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_synthetic" />
  </surfacematerial>
</materialx>
