<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <gltf_pbr name="SR_synthetic" type="surfaceshader">
    <input name="base_color" type="color3" value="0.15, 0.55, 0.30" />
    <input name="metallic" type="float" value="0.0" />
    <input name="roughness" type="float" value="0.40" />
    <input name="specular" type="float" value="1.0" />
    <input name="specular_color" type="color3" value="1.0, 1.0, 1.0" />
    <input name="ior" type="float" value="1.5" />
  </gltf_pbr>
  <surfacematerial name="Synthetic_GltfPbr" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_synthetic" />
  </surfacematerial>
</materialx>
