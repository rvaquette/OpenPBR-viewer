    <input name="roughness" type="float" value="0.35" />
    <input name="specular" type="float" value="0.5" />
    <input name="ior" type="float" value="1.5" />
  </disney_principled>
  <surfacematerial name="Synthetic_DisneyPrincipled" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_synthetic" />
  </surfacematerial>
</materialx>
