material default
{
    material_type materialx
    materialx_document ../mtlx-defaults/open_pbr_default.mtlx
}
camera
{
    position 6 5 8
    lookat 0 0 0
    fov 45
    aperture 0
    focaldist 8
}
gltf
{
    file ../test-material-disney-gold/openpbr_objects.glb
    object * default
}
light
{
    type quad
    position -1 4 -1
    v1 1 4 -1
    v2 -1 4 1
    emission 8 8 8
}
light
{
    type sphere
    position 2 2 0
    radius 0.5
    emission 3 1 0.5
}
light
{
    type distant
    position -0.5 1 0.5
    emission 0.25 0.25 0.25
}
renderer
{
    envmapfile none
    envmapirradiancefile none
    maxspp 2
    hideemitters false
}